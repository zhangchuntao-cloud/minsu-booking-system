<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.code.web_homework.mapper.PermissionMapper">

    <resultMap id="BaseResultMap" type="Permission">
        <id     column="id"            property="id"/>
        <result column="perm_code"     property="permCode"/>
        <result column="perm_name"     property="permName"/>
        <result column="perm_type"     property="permType"/>
        <result column="parent_id"     property="parentId"/>
        <result column="url"           property="url"/>
        <result column="icon"          property="icon"/>
        <result column="sort"          property="sort"/>
        <result column="created_by"    property="createdBy"/>
        <result column="creation_date" property="creationDate"/>
        <result column="modify_by"     property="modifyBy"/>
        <result column="modify_date"   property="modifyDate"/>
    </resultMap>

    <!--
      三表关联查询：sys_user → sys_role → sys_role_permission → sys_permission
      体现 RBAC 模型中「用户-角色-权限」的传递关系
    -->
    <select id="selectByRoleCode" resultMap="BaseResultMap">
        SELECT p.id, p.perm_code, p.perm_name, p.perm_type, p.parent_id,
               p.url, p.icon, p.sort, p.created_by, p.creation_date,
               p.modify_by, p.modify_date
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        INNER JOIN sys_role r ON rp.role_id = r.id
        WHERE r.role_code = #{roleCode}
        ORDER BY p.sort ASC
    </select>

</mapper>
